# install.sh writes .env after checking your local Ollama service.
AI_MODE=procedure
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
WEB_PORT=3001
APP_ORIGIN=http://localhost:3001
# For cloud deployment, set DOMAIN to a hostname you own. No protocol or path.
# DOMAIN=trialops.example.com
# Public limits override the local settings in compose.production.yaml.
ENABLE_DEMO=true
ENABLE_SIGNUP=true
DEMO_HOURLY_LIMIT=30
SIGNUP_HOURLY_LIMIT=20
