# Copy to .backup.env (git-ignored, chmod 600). Placeholders only.
# rclone remote, e.g. Backblaze B2 bucket; define credentials with rclone env vars or `rclone config`.
OFFSITE_REMOTE=offsite:YOUR-BUCKET/trialops
RCLONE_CONFIG_OFFSITE_TYPE=b2
RCLONE_CONFIG_OFFSITE_ACCOUNT=YOUR-KEY-ID
RCLONE_CONFIG_OFFSITE_KEY=YOUR-APPLICATION-KEY
RETENTION_DAYS=14
RESTORE_VERIFY=true
# Optional dead-man's-switch (e.g. healthchecks.io): success pings the URL, failure pings URL/fail.
HEALTHCHECK_URL=
